{
    "name": "fastedgy-template",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "web-types": "./web/web-types.json",
    "scripts": {
        "dev": "cd web && vite",
        "build": "cd web && NODE_OPTIONS='--max-old-space-size=4096' vite build",
        "preview": "cd web && vite preview",
        "test": "cd web && vitest run",
        "test:watch": "cd web && vitest",
        "lint": "oxlint . --type-aware",
        "fix": "oxlint --fix",
        "format": "oxfmt --write ./web/src ./web/vitest.setup.js ./web/vite.config.js"
    },
    "dependencies": {
        "@cyhnkckali/vue3-color-picker": "^2.1.5",
        "@internationalized/date": "^3.9.0",
        "@lucide/vue": "^1.43.0",
        "@tailwindcss/vite": "^4.3.3",
        "@unovis/ts": "^1.6.7",
        "@unovis/vue": "^1.6.7",
        "@vueuse/core": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lodash": "^4.17.21",
        "pinia": "^2.3.1",
        "reka-ui": "^2.10.4",
        "tailwind-merge": "^3.3.1",
        "tw-animate-css": "^1.3.5",
        "vue": "^3.5.42",
        "vue-draggable-plus": "^0.6.0",
        "vue-fastedgy": "github:krafterio/vue-fastedgy#main",
        "vue-i18n": "^11.1.12",
        "vue-router": "^4.6.4",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.4",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "3.9.6",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "allowScripts": {
        "fsevents": false,
        "maplibre-gl": false,
        "vue-demi": false
    }
}
